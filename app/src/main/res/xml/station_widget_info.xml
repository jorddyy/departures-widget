<?xml version="1.0" encoding="utf-8"?>
<!-- Station board: choose a stop when adding it; change it later from the widget's settings
     (long-press the widget). Defaults to 4x2, which shows four departures. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="app.departures.ui.StopPickerActivity"
    android:description="@string/station_widget_description"
    android:initialLayout="@layout/widget_station"
    android:previewLayout="@layout/widget_station"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
