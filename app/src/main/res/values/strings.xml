    <string name="location_title">Automatic direction</string>
    <string name="location_off_body">Let the app use your approximate location to tell whether you\'re near Home or Work. Without it, mornings show departures to Work and afternoons to Home.</string>
    <string name="location_fg_body">The widget picks the direction when you open the app. Allow location \"all the time\" so the widget can switch on its own. It only reads approximate location, never in the background unless the screen is on.</string>
    <string name="location_on_body">The widget picks the direction from your approximate location.</string>
    <string name="location_disabled_body">Location is turned off on this phone. The direction follows the time of day.</string>
    <string name="allow">Allow</string>
    <string name="allow_all_the_time">Allow all the time</string>
    <string name="minutes_title">Countdown in minutes</string>
    <string name="minutes_body">The widget is counting down in seconds. Allow \"Alarms &amp; reminders\" and it shows whole minutes instead, updated the moment the minute changes. These alarms never wake the phone.</string>
