<?xml version="1.0" encoding="utf-8"?>
<!-- One departure in the scrollable station board (Android 12+). Same columns as widget_station. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/row_line_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/row_line"
            android:layout_alignEnd="@+id/row_line"
            android:layout_alignStart="@+id/row_line"
            android:layout_alignTop="@+id/row_line"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/badge_bg" />

        <TextView
            android:id="@+id/row_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="30dp"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:textColor="@color/badge_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/row_dest"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

    <!-- Platform column: shown for every row when any departure has a platform (empty
         boxes are invisible, keeping the column aligned), gone otherwise. -->
    <TextView
        android:id="@+id/row_platform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/platform_bg"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="20dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:textColor="@color/widget_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Time with its delay right after it ("21:07 +1"), as one column of fixed minimum
         width, so the countdown and platform columns never move. Widths are in sp so they
         grow with the system font size. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:baselineAlignedChildIndex="0"
        android:minWidth="60sp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/row_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/widget_late"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/row_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:minWidth="62sp"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/row_min"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:minWidth="62sp"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
